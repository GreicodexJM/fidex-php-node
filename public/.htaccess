Options -Indexes

# Route all requests through index.php (front controller)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect legacy favicon.ico requests to the SVG favicon
    RewriteRule ^favicon\.ico$ /favicon.svg [R=301,L]

    # Allow direct access to static files that exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else to index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Allow large payloads (FideX spec: up to 10 MB)
<IfModule mod_php.c>
    php_value post_max_size 12M
    php_value upload_max_filesize 12M
    php_value memory_limit 64M
    php_value max_execution_time 60
</IfModule>

# Block direct access to sensitive paths
<Files ".env">
    Order allow,deny
    Deny from all
</Files>
