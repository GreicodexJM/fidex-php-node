{
    "name": "greicodexjm/fidex-php",
    "description": "FideX Protocol PHP Reference Implementation — secure B2B document exchange for pharmacies and distributors",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/GreicodexJM/fidex-protocol",
    "keywords": ["fidex", "b2b", "edi", "jwe", "jws", "pharmacy", "supply-chain"],
    "authors": [
        {
            "name": "GreicodexJM",
            "homepage": "https://github.com/GreicodexJM"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "web-token/jwt-framework": "^3.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "FideX\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FideX\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --testsuite Unit",
        "stan": "phpstan analyse src tests --level 5",
        "migrate": "php bin/migrate.php",
        "keys": "php bin/generate-keys.php",
        "worker": "php bin/worker.php",
        "serve": "php -S 0.0.0.0:8080 -t public/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable"
}
