# ─────────────────────────────────────────────────────────────────────────────
# FideX PHP Reference Implementation — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node Identity ─────────────────────────────────────────────────────────────
# Your unique node identifier. Use a URN: GLN, GS1 SGTIN, or custom URN.
# Examples:
#   GLN (Global Location Number): urn:gln:0614141000012
#   Custom:                       urn:custom:farmacia-san-juan
FIDEX_NODE_ID=urn:custom:your-pharmacy-name
FIDEX_NODE_NAME=Your Pharmacy Name
FIDEX_NODE_BASE_URL=https://yourdomain.com

# ── API Security ──────────────────────────────────────────────────────────────
# Secret key for local ERP → FideX node communication.
# Generate with: openssl rand -hex 32
FIDEX_API_KEY=change-this-to-a-random-secret-at-least-32-chars

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (recommended for shared hosting):
FIDEX_DB_DRIVER=sqlite
FIDEX_DB_PATH=storage/fidex.sqlite

# MySQL (optional, for higher concurrency):
# FIDEX_DB_DRIVER=mysql
# FIDEX_DB_HOST=127.0.0.1
# FIDEX_DB_PORT=3306
# FIDEX_DB_NAME=fidex
# FIDEX_DB_USER=fidex
# FIDEX_DB_PASSWORD=your-mysql-password

# ── Cryptographic Keys ────────────────────────────────────────────────────────
# Generate with: make keys  (or: php bin/generate-keys.php)
# ⚠ Private keys must be readable ONLY by the web server user (chmod 600)
FIDEX_SIGN_KEY_ID=sign-key-v1
FIDEX_SIGN_PRIVATE_KEY_PATH=keys/sign_private.pem
FIDEX_SIGN_PUBLIC_KEY_PATH=keys/sign_public.pem

FIDEX_ENC_KEY_ID=enc-key-v1
FIDEX_ENC_PRIVATE_KEY_PATH=keys/enc_private.pem
FIDEX_ENC_PUBLIC_KEY_PATH=keys/enc_public.pem

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: debug | info | warning | error
FIDEX_LOG_PATH=storage/logs/fidex.log
FIDEX_LOG_LEVEL=info
